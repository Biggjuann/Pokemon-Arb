# ---------------------------------------------------------------------------
# Copy to .env for local development. On Railway, set these as service
# variables instead (Settings -> Variables). Never commit real credentials.
# ---------------------------------------------------------------------------

# Storage. Locally this defaults to a SQLite file under ./data.
# On Railway, add a Postgres plugin and reference it:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_URL=sqlite:///./data/pokearb.db

# --- eBay Browse API (developer.ebay.com -> your keyset) -------------------
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production
EBAY_MARKETPLACE=EBAY_US
EBAY_CATEGORY_ID=183454
EBAY_DELIVERY_COUNTRY=US
EBAY_MAX_CALLS_PER_SCAN=400

# --- eBay marketplace account deletion notifications -----------------------
# REQUIRED for production. eBay will not authenticate a production keyset
# until it has validated this endpoint. Generate the token with
# `pokearb ebay-token`, then register the same URL + token in the developer
# console under Application Keys -> Notifications.
# The URL must match the console entry exactly -- it is hashed into the
# challenge response, so a trailing slash or http:// will fail validation.
EBAY_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT_URL=https://your-app.up.railway.app/ebay/account-deletion

# --- PriceCharting API token (pricecharting.com subscriber area) -----------
PRICECHARTING_TOKEN=

# --- valuation -------------------------------------------------------------
# "pricecharting" values against recent SOLD prices and needs a paid token.
# "peer" needs no second API at all: a listing is valued against what other
# live eBay listings for the same card and grade are ASKING. Weaker evidence,
# and every deal from it carries a PEER_COMP risk flag.
COMP_SOURCE=pricecharting
# Asks skew high and the listings that clear sit low in the distribution, so
# the comp is a low percentile of the peer asks rather than the median.
PEER_COMP_PERCENTILE=0.35
# Groups smaller than this are not priced at all.
PEER_MIN_SAMPLE=5

# --- deal economics --------------------------------------------------------
SELL_FEE_RATE=0.1355
SELL_FEE_FIXED_CENTS=40
OUTBOUND_SHIPPING_CENTS=500
BUYER_TAX_RATE=0.08
CONDITION_HAIRCUT=0.90

# --- ranking thresholds ----------------------------------------------------
MIN_PROFIT_CENTS=1000
MIN_ROI=0.25
MIN_MATCH_CONFIDENCE=0.62
MIN_SALES_VOLUME=3
TOO_GOOD_TO_BE_TRUE_DISCOUNT=0.90

# --- scanning --------------------------------------------------------------
SCAN_TOP_CARDS_PER_SET=25
SCAN_LISTINGS_PER_TARGET=50
SCAN_MAX_PRICE_CENTS=100000

# How stale displayed eBay listing data may be, in minutes. eBay's API License
# Agreement 8.1(c) caps this at 360 (6 hours); higher values are clamped down.
LISTING_FRESHNESS_MINUTES=360

# Run a scan inside the web process every N minutes. 0 = off (use a Railway
# cron service running `pokearb scan` instead, which is preferred). Keep this
# below LISTING_FRESHNESS_MINUTES or deals spend part of each cycle hidden.
SCAN_INTERVAL_MINUTES=0

# Seed the synthetic demo catalog on first boot so a fresh deploy is not empty.
SEED_DEMO_ON_STARTUP=false
DEMO_MODE=false

# Railway injects PORT automatically; HOST defaults to 0.0.0.0.
# PORT=8000
